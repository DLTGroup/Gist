# --- Summarization (Claude) ---
# Set one of these to use Claude. With neither set, the API runs in demo mode
# (a simple extractive summarizer) so the whole product can be tried end to end.
ANTHROPIC_API_KEY=
# Model and effort (defaults shown)
GIST_MODEL=claude-opus-5-5
GIST_EFFORT=medium

# --- Podcast audio transcription (only needed when a feed has no transcript) ---
DEEPGRAM_API_KEY=

# --- Server ---
PORT=8787
GIST_DB_PATH=./gist.db
# Comma-separated list of allowed web origins for CORS (desktop/mobile use bearer tokens)
GIST_CORS_ORIGINS=http://localhost:5173
