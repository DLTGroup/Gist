# --- Summarization models (server-side only; users never choose) ---
# Ordered list of provider/model. The first writes gists; the next takes over if it fails.
# Change it and restart to swap models. See docs/MODELS.md. With no usable model the API
# runs in demo mode (a simple extractive summarizer).
GIST_MODELS=anthropic/claude-opus-5-5
# Keys for whichever providers GIST_MODELS uses:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible endpoint (self-hosted, new provider): use custom/<model>
GIST_CUSTOM_BASE_URL=
GIST_CUSTOM_API_KEY=
# Reasoning effort for Anthropic models
GIST_EFFORT=medium

# --- YouTube: have Gemini watch the video (needs GEMINI_API_KEY) ---
# transcript-first: captions when available, the video itself when not (or when YouTube blocks us)
# video-first: always watch the video (sees slides and demos; uses about 100 tokens per second)
# transcript-only: never watch videos. Automatic when GEMINI_API_KEY is empty.
GIST_YOUTUBE_MODE=transcript-first
GIST_VIDEO_MODEL=gemini-3.8-flash

# --- Podcast audio transcription (only needed when a feed has no transcript) ---
DEEPGRAM_API_KEY=

# --- Connected accounts (optional): import saved YouTube / Spotify lists ---
# Redirect URIs to register with each provider: <GIST_PUBLIC_URL>/api/connections/youtube/callback
# and <GIST_PUBLIC_URL>/api/connections/spotify/callback. See docs/CONNECTED_ACCOUNTS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# At least 32 random characters; encrypts stored account tokens. e.g. openssl rand -base64 48
GIST_TOKEN_KEY=

# --- Server ---
PORT=8787
GIST_DB_PATH=./gist.db
# Comma-separated list of allowed web origins for CORS (desktop/mobile use bearer tokens)
GIST_CORS_ORIGINS=http://localhost:5173
